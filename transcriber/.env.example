# Supabase project (same one the app uses) and its service_role key
# (Dashboard > Project Settings > API). The service role bypasses RLS so
# the worker can see every user's queued notes - keep this file private.
SUPABASE_URL=https://jixjuabvprbyupmaqtma.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key for summaries (the same one as C:\dev\Summaries\.env works).
ANTHROPIC_API_KEY=sk-ant-...
# Optional: defaults to claude-opus-5-5.
CLAUDE_MODEL=

# Optional WhisperX settings (defaults: large-v2, pt).
WHISPER_MODEL=large-v2
WHISPER_LANGUAGE=pt

# Optional: fallback polling interval in seconds, in case the realtime
# connection drops (default 60). New notes normally arrive via realtime.
POLL_SECONDS=60

# Optional: chat with the local assistant (Chat tab -> robot button,
# migrations/047_bot_chats.sql). Defaults: same model as the voice-note
# assistant, 16k context, no thinking, model kept loaded 300 s after the
# last answer (it is always unloaded before a transcription).
BOT_MODEL=
BOT_CTX=16384
BOT_THINK=
BOT_IDLE_SECONDS=300

# Optional: voice messages in the assistant chat (migrations/048).
# Parakeet v3 (speech -> text, PT/EN auto) and Kokoro (text -> speech) run
# on the CPU. KOKORO_VOICE is only the fallback; each chat picks its voice.
PARAKEET_MODEL=nemo-parakeet-tdt-0.6b-v3
KOKORO_DIR=
KOKORO_VOICE=pf_dora
