# Supabase project (same one the app uses) and its service_role key
# (Dashboard > Project Settings > API). The service role bypasses RLS so
# the worker can see every user's queued notes - keep this file private.
SUPABASE_URL=https://jixjuabvprbyupmaqtma.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key for summaries (the same one as C:\dev\Summaries\.env works).
ANTHROPIC_API_KEY=sk-ant-...
# Optional: defaults to claude-opus-5-5.
CLAUDE_MODEL=

# Optional WhisperX settings (defaults: large-v2, pt).
WHISPER_MODEL=large-v2
WHISPER_LANGUAGE=pt

# Optional: fallback polling interval in seconds, in case the realtime
# connection drops (default 60). New notes normally arrive via realtime.
POLL_SECONDS=60
